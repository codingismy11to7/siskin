<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- protectionLevel is "normal", so this is granted at install with no
         runtime prompt — confirmed against the AAOS emulator image. It gates
         INFO_MAKE / INFO_MODEL / INFO_MODEL_YEAR, which name this car in the
         Plex account's device list. -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <!-- Siskin exists to run natively on Android Automotive OS head units, not on
         phones. Declaring the feature as required states that plainly and lets the
         platform and store filter accordingly. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Three attributes, one posture: Siskin's data does not leave the head unit
         through backup or transfer. None is redundant across minSdk 28 to target 36:
         dataExtractionRules is read only from API 31, fullBackupContent only below
         it, and allowBackup is what actually disables backup pre-31. -->
    <!-- UnusedAttribute is suppressed for localeConfig, which the platform reads
         only from API 33 while minSdk is 28. Inert below that and kept anyway:
         it pairs with localeFilters in app/build.gradle, and the platform
         ignores attributes it does not know. See the five-locales design doc. -->
    <application
        android:name="App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="UnusedAttribute">

        <!-- required="false" is load-bearing, and not because a head unit might
             lack the library. android.car is absent from the package manager's
             shared-library registry on AAOS — the classes live on the
             BOOTCLASSPATH — and a <uses-library> is checked against that
             registry, so required="true" fails the install with
             INSTALL_FAILED_MISSING_SHARED_LIBRARY on a device where the classes
             are always present. required="false" covers both ways a platform
             can ship it. See the 2026-08-27 design. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- No `com.google.android.gms.car.application` meta-data here, and there
             must never be one again. Play rejects outright any app declaring it
             alongside the `android.hardware.type.automotive` feature above,
             because the two describe mutually exclusive distribution models: a
             native AAOS app running on the head unit, versus a phone app
             projecting into Android Auto. Siskin is the former by definition,
             so the projection meta-data inherited from tempo is gone, along
             with the @xml/auto_app_desc resource it pointed at.

             The androidx.car.app.TintableAttributionIcon meta-data went with
             it. That library is not a dependency of this project, so the
             declaration referenced a class absent from the classpath.

             Apps that genuinely ship both, such as Pocket Casts, are not
             breaking this rule: the restriction is per *artifact*, not per
             app. Pocket Casts keeps two Gradle modules, `app/` for the phone
             build with the projection meta-data and `automotive/` for the
             AAOS build with the uses-feature, sharing one applicationId and
             one Play listing because Play gives the Automotive OS form factor
             its own release track. Note that a product flavor would NOT work
             for this: flavors merge into a single manifest and would hit the
             same rejection. If Siskin ever wants a phone build, which the
             whole point of the fork argues against, it needs a second module. -->

        <!-- automotive_app_desc, not auto_app_desc. The deleted resource named
             in the comment above is a different file for a different platform:
             that one opted into Android Auto projection, this one opts into
             Android Automotive OS. The names are one letter apart, and anyone
             reading the removal above should not conclude this is the same
             resource resurrected.

             Without this, the settings gear the car draws in its top bar stays
             inert and the APPLICATION_PREFERENCES activity below is
             unreachable. -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!-- Android Automotive OS sign-in. Reached two ways: the resolution
             PendingIntent on a browse error, and the settings gear the car
             draws in its top bar.

             The gear is why this is exported. The platform starts the activity
             on our behalf, which it cannot do otherwise. Nothing is read from
             the incoming intent, so an outside caller can make a sign-in screen
             appear and nothing more. This is still not a launcher activity.
             There is no MAIN/LAUNCHER filter and there must not be one; the
             tile AAOS shows in the app grid comes from MediaService's
             androidx.car.app.launchable meta-data, not from here.

             There is deliberately no distractionOptimized meta-data: AAOS
             restricts keyboard input while driving, so a sign-in form cannot be
             distraction-optimized in a compliant way. Its absence makes the
             platform block this screen while the car is moving.

             taskAffinity gives this activity its own task, separate from the
             applicationId default any other activity would share.
             CarSignInResolution's PendingIntent launches this activity with
             NEW_TASK|CLEAR_TASK, and CLEAR_TASK clears whatever task shares
             this activity's affinity. CarHostActivity is the app's only
             activity, so nothing else occupies that default task today, but
             the distinct affinity is what keeps CLEAR_TASK scoped to just
             this activity's own task rather than relying on that staying
             true. -->
        <activity
            android:name=".ui.activity.CarHostActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=":car_host"
            android:theme="@style/AppTheme">

            <!-- What the car's settings gear launches. Verified on the
                 emulator: without this filter the gear renders as an inert
                 outline, with it the gear becomes a live button.

                 AAOS does not launch this activity on its own when there is no
                 session. The browse result is still what the car shows
                 first. -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- ExportedService is suppressed, and what it warns about is real: this
             is exported with no android:permission, so anything on the head unit
             can bind and get the default session and library commands. There is
             no caller guard in code either: BaseSessionCallback.onConnect
             accepts every controller and only varies the command set. A manifest
             permission is not the fix (the car's media UI could not hold one);
             vetting in onConnect is, and it is #154. Accepted meanwhile because
             a production head unit's app set is curated. -->
        <service
            android:name=".service.MediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">

            <!-- Android Automotive OS opt-in. AAOS looks for this meta-data on
                 the MediaBrowserService itself, and without it logs "Skipping
                 MBS for {...} belonging to non media template app" and never
                 lists the app as a media source.

                 Despite the prefix, this does not require androidx.car.app.
                 The name is just a string AAOS reads, and that library is not
                 a dependency of this project. Do not confuse it with the
                 projection meta-data removed from the application element
                 above, which Play rejects outright. -->
            <meta-data
                android:name="androidx.car.app.launchable"
                android:value="true" />

            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService"/>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/>
            </intent-filter>
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            Exported because the system's AccountManagerService binds this from
            Not exported, and measured rather than assumed: the reasoning that
            it had to be is wrong. AccountManagerService binds this from
            outside the app's uid, which looks like it should need exporting —
            but it binds through the system's own privileges, so `exported`
            never enters into it. Verified on the AAOS emulator against this
            exact declaration: Settings › Accounts › Add account › Siskin
            binds the service and reaches the PIN screen, with no
            SecurityException and no bind failure in the log.

            Keeping it unexported is what avoids an ExportedService warning
            that MediaService carries only because that one genuinely must be
            exported for AAOS to discover it.
        -->
        <service
            android:name=".plex.account.PlexAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!-- Exported because com.android.car.media loads these URIs itself, and
             unexported it shows no art. ExportedContentProvider is suppressed on
             the same terms as MediaService above: openFile fetches from the Plex
             server with the user's token and does not check getCallingPackage(),
             so any app here can use Siskin as an authenticated image proxy. The
             URI is validated, the caller is not. #154. -->
        <provider
            android:name=".provider.AlbumArtContentProvider"
            android:authorities="${applicationId}.albumart.provider"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedContentProvider"
        />

    </application>
</manifest>
