<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Siskin exists to run natively on Android Automotive OS head units, not on
         phones. Declaring the feature as required states that plainly and lets the
         platform and store filter accordingly. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:name="App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.SplashScreen"
        android:usesCleartextTraffic="true">

        <!-- Declare that this session demo supports Android Auto. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/auto_app_desc" />

        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_graphic_eq" />

        <!-- Android Automotive OS sign-in. Reached only through the resolution
             PendingIntent on the browse error, so it is not exported and has no
             launcher intent-filter.

             There is deliberately no distractionOptimized meta-data: AAOS
             restricts keyboard input while driving, so a sign-in form cannot be
             distraction-optimized in a compliant way. Its absence makes the
             platform block this screen while the car is moving.

             taskAffinity is its own task, separate from MainActivity's (both
             would otherwise default to the applicationId affinity and share
             one task). CarSignInResolution's PendingIntent launches this
             activity with NEW_TASK|CLEAR_TASK, and CLEAR_TASK clears whatever
             task shares this activity's affinity. Without a distinct
             affinity here, tapping "Sign in" would finish MainActivity (and
             everything above it) instead of only clearing this activity's
             own task: silently destructive if removed. -->
        <activity
            android:name=".ui.activity.CarSignInActivity"
            android:exported="false"
            android:label="@string/car_sign_in_title"
            android:launchMode="singleTop"
            android:taskAffinity=":car_sign_in"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".service.MediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">

            <!-- Android Automotive OS opt-in. This is separate from the Android
                 Auto opt-in declared on <application> above: AAOS looks for this
                 meta-data on the MediaBrowserService itself, and without it logs
                 "Skipping MBS for {...} belonging to non media template app" and
                 never lists the app as a media source. -->
            <meta-data
                android:name="androidx.car.app.launchable"
                android:value="true" />

            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService"/>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/>
            </intent-filter>
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name=".provider.AlbumArtContentProvider"
            android:authorities="${applicationId}.albumart.provider"
            android:enabled="true"
            android:exported="true"
        />

    </application>
</manifest>
