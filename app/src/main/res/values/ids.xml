<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The debug rail's menu item ids. Material reads 0 as "no item", and sets
        each id on its item view, where a small integer can collide with
        View.generateViewId(). Hence these rather than DebugTab ordinals.
    -->
    <item name="debug_tab_server" type="id" />
    <item name="debug_tab_car" type="id" />
    <item name="debug_tab_failures" type="id" />
    <item name="debug_tab_voice" type="id" />
    <item name="debug_tab_changelog" type="id" />

    <!-- Settings' rail, for the same reason. -->
    <item name="settings_category_playback" type="id" />
    <item name="settings_category_browse" type="id" />
    <item name="settings_category_storage" type="id" />
    <item name="settings_category_account" type="id" />
    <item name="settings_category_about" type="id" />
</resources>
