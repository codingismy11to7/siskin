<?xml version="1.0" encoding="utf-8"?>
<!--
    Shown in Settings' detail pane, beside the rail, so it takes the pane's
    padding and lines up with the category rows it replaces. The reset button
    sits at end|top, level with the heading.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tab_order_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/plex_sign_in_row_padding"
            android:layout_marginBottom="4dp"
            android:text="@string/car_tab_order_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:id="@+id/tab_order_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/plex_sign_in_row_padding"
            android:layout_marginBottom="16dp"
            android:text="@string/car_tab_order_hint"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tab_order_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/tab_order_reset"
        style="@style/CarCornerButton"
        android:layout_gravity="end|top"
        android:layout_marginTop="-16dp"
        android:contentDescription="@string/car_tab_order_reset"
        android:src="@drawable/ic_settings_backup_restore" />
</FrameLayout>
