<?xml version="1.0" encoding="utf-8"?>
<!--
    The Car tab of the debug screen. See
    docs/decisions/2026-10-25-debug-tabs-design.md.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadingEdgeLength="48dp"
    android:paddingBottom="32dp"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/debug_device_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <!-- Monospace and full width for the same reason the Server tab's address_text is. -->
        <TextView
            android:id="@+id/device_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
