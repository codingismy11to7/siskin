<?xml version="1.0" encoding="utf-8"?>
<!--
    minHeight is plex_sign_in_choice_min_height, the head-unit tap target the
    settings buttons already use. A drag handle smaller than that is not
    grabbable at arm's length.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/plex_sign_in_choice_min_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/tab_order_handle"
        android:layout_width="@dimen/plex_sign_in_choice_min_height"
        android:layout_height="@dimen/plex_sign_in_choice_min_height"
        android:contentDescription="@string/car_tab_order_drag_handle"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_drag_handle"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tab_order_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

    <TextView
        android:id="@+id/tab_order_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
</LinearLayout>
