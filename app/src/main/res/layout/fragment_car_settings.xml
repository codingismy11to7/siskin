<?xml version="1.0" encoding="utf-8"?>
<!--
    Categories on a rail down the start edge, the selected one's rows beside it;
    the rail is the debug screen's. See
    docs/decisions/2026-11-07-settings-two-pane-design.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/settings_rail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainer"
        app:headerLayout="@layout/car_rail_header"
        app:itemIconSize="32dp"
        app:itemMinHeight="@dimen/plex_sign_in_choice_min_height"
        app:itemTextAppearanceActive="@style/TextAppearance.Material3.TitleMedium"
        app:itemTextAppearanceInactive="@style/TextAppearance.Material3.TitleMedium"
        app:labelVisibilityMode="labeled"
        app:menuGravity="top" />

    <!--
        The detail pane shows either the selected category's rows or a screen
        opened from one of them (a picker, Customize tabs) in their place.
    -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:id="@+id/pane_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/category_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/category_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/plex_sign_in_row_padding"
                android:layout_marginBottom="16dp"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                tools:text="Playback" />

            <!-- Only the rows scroll; see FadingScrollView for the faded edge. -->
            <ScrollView
                android:id="@+id/content_scroll"
                style="@style/FadingScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <!-- One child per category, built in code; only the selected one is visible. -->
                <FrameLayout
                    android:id="@+id/category_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
