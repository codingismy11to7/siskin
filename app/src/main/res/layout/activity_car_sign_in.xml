<?xml version="1.0" encoding="utf-8"?>
<!--
    A header row above the content, not a button overlaying it.

    The back button has to exist in every state the fragment renders
    (Disconnected, Working, AwaitingApproval, the pickers, Connected), and the
    activity is what hosts all of them, so it belongs here rather than inside
    the fragment.

    It was first written as a sibling overlay on a FrameLayout, which forced
    the fragment to offset its heading by the button's width to avoid being
    sat on. That offset moved the heading and not the content beneath it, so a
    centred Sign out button ended up under a heading nudged right of centre and
    the two visibly disagreed. Giving the button its own row costs one row of
    height and removes the whole class of problem: nothing overlaps, so nothing
    has to dodge, and every state stays on true centre.

    This is also the shape Pocket Casts uses for the equivalent screen, whose
    APPLICATION_PREFERENCES pattern this activity follows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        This activity draws no toolbar, and the AAOS emulator's system bar has
        no Back button, so without this the screen is a dead end: the only exit
        would be completing sign-in, which reaches Done and calls finish(). A
        head unit's hardware back affordance is not something to rely on
        either, since it varies by OEM.

        Sized to plex_sign_in_choice_min_height, the head-unit tap target the
        choice buttons already use, rather than a phone-sized icon button.
    -->
    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="@dimen/plex_sign_in_choice_min_height"
        android:layout_height="@dimen/plex_sign_in_choice_min_height"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/car_sign_in_back_description"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back_arrow"
        app:tint="?attr/colorOnSurface" />

    <FrameLayout
        android:id="@+id/car_sign_in_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
