<?xml version="1.0" encoding="utf-8"?>
<!--
    fillViewport is what makes the centering work: without it the ScrollView
    sizes its child to wrap_content and gravity has nothing to distribute.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/car_sign_in_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/approval_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!--
                The QR stays black-on-white even in dark mode. Plex serves the
                code as a tintable mask and a scanner needs the light quiet
                zone, so this is a deliberate white card rather than a styling
                oversight.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/qr_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/qr_image"
                    android:layout_width="@dimen/plex_sign_in_qr_size"
                    android:layout_height="@dimen/plex_sign_in_qr_size"
                    android:contentDescription="@string/plex_sign_in_qr_description"
                    android:padding="16dp"
                    android:tint="@android:color/black" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plex_sign_in_instructions"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/code_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.2"
                    android:textAppearance="?attr/textAppearanceDisplaySmall"
                    android:textStyle="bold"
                    tools:ignore="UnusedAttribute" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/choice_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/choice_container"
            android:layout_width="@dimen/plex_sign_in_choice_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:visibility="gone" />

        <!--
            insetTop/Bottom default to 6dp on MaterialButton and eat into the
            touch target, so a 72dp minHeight would render as 60dp of tappable
            button. Zeroed here because arm's-length taps in a car are the whole
            point of the oversized target.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:minHeight="@dimen/plex_sign_in_choice_min_height"
            android:minWidth="@dimen/plex_sign_in_button_min_width"
            android:text="@string/plex_sign_in_retry"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnPrimary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
