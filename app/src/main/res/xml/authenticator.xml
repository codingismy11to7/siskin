<?xml version="1.0" encoding="utf-8"?>
<!--
    accountType is a generated resource rather than a literal — see the
    resValue in app/build.gradle. A literal would be shared by the debug and
    release builds, which cannot both own one account type.
-->
<account-authenticator xmlns:android="http://schemas.android.com/apk/res/android"
    android:accountType="@string/plex_account_type"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:smallIcon="@mipmap/ic_launcher" />
