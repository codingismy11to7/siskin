<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages Siskin actually ships, and the list the system's per-app language
  picker offers. Must stay in step with localeFilters in app/build.gradle: a locale
  listed here but dropped by the filter advertises a language whose resources are
  not in the bundle.

  Bare language tags rather than de-DE / es-ES: the app carries one strings.xml per
  language with no regional variants, so es matches Latin America as readily as
  Spain.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en"/>            <!-- English -->
    <locale android:name="de"/>            <!-- German -->
    <locale android:name="es"/>            <!-- Spanish -->
    <locale android:name="fr"/>            <!-- French -->
    <locale android:name="it"/>            <!-- Italian -->
</locale-config>
